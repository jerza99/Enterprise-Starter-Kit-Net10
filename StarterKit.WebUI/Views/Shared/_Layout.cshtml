<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] | StarterKit.WebUI</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/StarterKit.WebUI.styles.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark custom-navbar shadow-sm sticky-top">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center fw-bold" asp-controller="Home" asp-action="Index">
                <div class="logo-icon me-2 d-flex align-items-center justify-content-center">
                    <i class="bi bi-rocket-takeoff-fill"></i>
                </div>
                STARTER<span class="text-info">KIT</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link nav-link-custom px-3" asp-controller="Home" asp-action="Index">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link nav-link-custom px-3" asp-controller="Home" asp-action="Privacy">Privacy</a>
                    </li>
                </ul>
                <div class="d-flex gap-3 align-items-center">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <span class="navbar-text me-2 text-white d-flex align-items-center">
                            <div class="logo-icon-small me-2">
                                <i class="bi bi-person-fill"></i>
                            </div>
                            @User.Identity.Name
                        </span>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn-logout-navbar">
                                <div class="logo-icon-small me-2">
                                    <i class="bi bi-box-arrow-right"></i>
                                </div>
                                Cerrar Sesión
                            </button>
                        </form>
                    }
                    else
                    {
                        @if (ViewContext.RouteData.Values["controller"]?.ToString() != "Account" ||
                                    ViewContext.RouteData.Values["action"]?.ToString() != "Login")
                        {
                            <a class="btn text-white fw-semibold" asp-controller="Account" asp-action="Login">Iniciar Sesión</a>
                        }
                        @if (ViewContext.RouteData.Values["controller"]?.ToString() != "Account" ||
                                    ViewContext.RouteData.Values["action"]?.ToString() != "Register")
                        {
                            <a class="btn btn-light text-primary fw-bold rounded-3 px-4" asp-controller="Account" asp-action="Register">Registrarse</a>  
                        }
                    }
                </div>
            </div>
        </div>
    </nav>
    <div class="container layout-main-wrapper">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top py-4 mt-5">
        <div class="container text-center text-muted">
            <p class="mb-0">&copy; 2026 - StarterKit.WebUI - Todos los derechos reservados</p>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
